pendent_mastery":false,"event_kind":"formal_summary","event_time":null,"evidence_refs":[{"source_fragment":"","source_id":"CO_2022_004","source_kind":"formal_summary","source_sha256":"b8e331ccbcf9e9f4e467b2091232538e321dd3f55694ba2b855480f4ca3024af"}],"evidence_role":"formal_summary","formal_ids":["CO_2022_004"],"knowledge_point":"CO03-17","observed_date":"2026-07-05","outcome":null,"point_binding":"question_associated","prompt_dependency":"unknown","reasoning_result":null,"record_key":"KLR-886381b0144b3bf8697cb8beb6fab6932fc951125b09cefa1ff7d86f87d9a69c","review_marker":null,"source_access":null,"source_available":null,"source_fragment":"","source_id":"CO_2022_004","source_kind":"formal_summary","source_locator":"","source_order":null,"source_sha256":"b8e331ccbcf9e9f4e467b2091232538e321dd3f55694ba2b855480f4ca3024af","summary":"2026-07-05 入库：不清楚题目中“比较器的个数和位数”分别指什么，把比较器个数往 Cache 组数方向估算；讲解后确认组相联一次访问只进入一组，比较器个数等于该组内路数，比较器位数等于 Tag 位数。；先按块大小求块内地址位数，再用数据区容量和块大小求总行数，用总行数除以路数得到组数并求组号位数；最后用主存地址位数减去组号和块内地址得到 Tag 位数，并把比较器个数直接对应为路数。","summary_truncated":false},{"choice_result":null,"chronology_precision":"date_only","conclusion_correct":null,"correction_refs":null,"correction_result":null,"effective_observed_date":null,"effective_outcome":null,"establishes_independent_mastery":false,"event_kind":"formal_summary","event_time":null,"evidence_refs":[{"source_fragment":"","source_id":"CO_2012_006","source_kind":"formal_summary","source_sha256":"a70033fef8cb1eb9de5b658154ca97814fb4d08cf895858d938f21cd5f4cef2c"}],"evidence_role":"formal_summary","formal_ids":["CO_2012_006"],"knowledge_point":"CO03-17","observed_date":"2026-07-05","outcome":null,"point_binding":"question_associated","prompt_dependency":"unknown","reasoning_result":null,"record_key":"KLR-7c3638d12ca345108cec05888e5acdcc6b7201fc5ded9487449440428b2317d7","review_marker":null,"source_access":null,"source_available":null,"source_fragment":"","source_id":"CO_2012_006","source_kind":"formal_summary","source_locator":"","sour