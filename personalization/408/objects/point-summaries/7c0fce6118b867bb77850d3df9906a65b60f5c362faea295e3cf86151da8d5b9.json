:"date_only","conclusion_correct":null,"correction_refs":null,"correction_result":null,"effective_observed_date":null,"effective_outcome":null,"establishes_independent_mastery":false,"event_kind":"formal_summary","event_time":null,"evidence_refs":[{"source_fragment":"","source_id":"CN_2023_002","source_kind":"formal_summary","source_sha256":"d17963c5c39bf4478c0d9009967daf1aa1ea446aafbfb021c911fed55a6edc8c"}],"evidence_role":"formal_summary","formal_ids":["CN_2023_002"],"knowledge_point":"CN03-13","observed_date":"2026-07-25","outcome":null,"point_binding":"question_associated","prompt_dependency":"unknown","reasoning_result":null,"record_key":"KLR-d13579e05ff65421e7793646b4a1fef8c8365bec654d50d4d4fe8b8f510dfc7e","review_marker":null,"source_access":null,"source_available":null,"source_fragment":"","source_id":"CN_2023_002","source_kind":"formal_summary","source_locator":"","source_order":null,"source_sha256":"d17963c5c39bf4478c0d9009967daf1aa1ea446aafbfb021c911fed55a6edc8c","summary":"2026-07-25 入库：比较 GBN 与 SR 时换错尺子。已正确写出利用率等于发送窗口乘一帧发送时延再除以周期，也正确判定停止-等待最小，但改用丢帧后的重传效率立论，认为 SR 能只重传丢失帧而 GBN 要回退重传整批因此 SR 利用率更高；该描述本身正确但刻画的是有丢包时的实际效率，而题目问最大利用率即理想无差错情形，此时不发生重传。同时遗漏题干括号给出的发送窗口与接收窗口相等这一唯一定量入口，也未调用当日已建立的窗口与序号空间通式把三个发送窗口算出来。追问中另暴露三处：把接收窗口理解成总共能收几帧而非能缓存几个失序帧；把发送方能收到多个确认帧归因于接收窗口；认为 GBN 会为连续多帧分别回送独立确认。；先读最大二字确认是理想无差错无重传情形，把发送时延与周期作为公共因子约掉，再用发送窗口加接收窗口不超过序号空间逐协议求发送窗口（停等 1、GBN 2^k − 1、SR 对称时 2…","summary_truncated":true},{"choice_result":null,"chronology_precision":"date_only","conclusion_correct":null,"correction_refs":null,"correction_result":null,"effective_observed_date":null,"effective_outcome":null,"establishes_independent_mastery":false,"event_kind":"formal_summary","event_time":null,"evidence_refs":[{"source_fragment":"","source_id":"CN_2019_001","source_kind":"formal_summary","source_sha256":"aefe09b99a3b160ff845fd7999072133325f49bb61cb3cdcd7bfd015a34d8225"}],"evidence_role":"formal_summary","formal_ids":["CN_2019_001"],"knowledge_point":"CN03-13","observed_date":"2026-07-25","outcome":null,"point_binding":"question_associated","prompt_dependency":"unknown","reasoning_result":null,"record_key":"KLR-761d8bcd2bf5321399f2150ffbe19c782805809ecdb8ba4ca2dc0c655e78453b","review_marker":null,"source_access":null,"source_available":null,"source_fragment":"","source_id":"CN_2019_001","source_kind":"formal_summary","source_locator":"","source_order":null,"source_sha256":"aefe09b99a3b160ff845fd7999072133325f49bb61cb3cdcd7bfd015a34d8225","summary":"2026-07-25 入库：把后退N帧的发送窗口上限 2^n − 1 当成选择重传的通用序号空间上限，写成发送窗口加接收窗口不超过 7，等于把减一扣了两遍，因而接收窗口少算一格得到 2；同时未显式判型为 SR，也未核验接收窗口不超过发送窗口这条副约束。；先按发送窗口大于一且接收窗口为未知量判定协议为 SR，再写序号空间 2^n（不减一），然后列主约束发送窗口加接收窗口不超过 2^n 与副约束接收窗口不超过发送窗口，最后取两者较小值并允许取等号。","summary_truncated":false}],"hint_count":3,"historical_understanding":[{"choice_result":null,"chronology_precision":"source_order","conclusion_correct":null,"correction_refs":null,"correction_result":null,"effective_observed_date":null,"effective_outcome":null,"establishes_independent_mastery":false,"event_kind":"observation","event_time":null,"evidence_refs":[{"source_fragment":"learner_evidence","source_id":"current-question-evidence://sha256/cf80ec75ecc3d22e9bda56a82cd71a0af9029331350aa364338277e67f736ac5","source_kind":"semantic_legacy_original","source_sha256":"cf80ec75ecc3d22e9bda56a82cd71a0af9029331350aa364338277e67f736ac5"}],"evidence_role":"observed_learner_evidence","formal_ids":[],"knowledge_point":"CN03-13","observed_date":"2026-08-05","outcome":null,"point_binding":"explicit_point","prompt_dependency":"independent","reasoning_result":null,"record_key":"KLR-6ae11bbcc1204dc6d53f61d7fa60597f9abce87755f72be63ce5ca17487cec0f","review_marker":null,"source_access":null,"source_available":null,"source_fragment":"learner_evidence","source_id":"current-question-evidence://sha256/cf80ec75ecc3d22e9bda56a82cd71a0af9029331350aa364338277e67f736ac5","source_kind":"semantic_legacy_original","source_locator":"current-question-evidence://sha256/cf80ec75ecc3d22e9bda56a82cd71a0af9029331350