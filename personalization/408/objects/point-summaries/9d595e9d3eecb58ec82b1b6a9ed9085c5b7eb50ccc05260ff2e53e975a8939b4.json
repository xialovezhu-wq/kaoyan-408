fective_observed_date":null,"effective_outcome":null,"establishes_independent_mastery":false,"event_kind":"formal_summary","event_time":null,"evidence_refs":[{"source_fragment":"","source_id":"CN_2023_002","source_kind":"formal_summary","source_sha256":"d17963c5c39bf4478c0d9009967daf1aa1ea446aafbfb021c911fed55a6edc8c"}],"evidence_role":"formal_summary","formal_ids":["CN_2023_002"],"knowledge_point":"CN03-10","observed_date":"2026-07-25","outcome":null,"point_binding":"question_associated","prompt_dependency":"unknown","reasoning_result":null,"record_key":"KLR-5d2ca7ce8a8613345118d0160f4d4c397afe3b36f3501041444d4361f09c552d","review_marker":null,"source_access":null,"source_available":null,"source_fragment":"","source_id":"CN_2023_002","source_kind":"formal_summary","source_locator":"","source_order":null,"source_sha256":"d17963c5c39bf4478c0d9009967daf1aa1ea446aafbfb021c911fed55a6edc8c","summary":"2026-07-25 入库：比较 GBN 与 SR 时换错尺子。已正确写出利用率等于发送窗口乘一帧发送时延再除以周期，也正确判定停止-等待最小，但改用丢帧后的重传效率立论，认为 SR 能只重传丢失帧而 GBN 要回退重传整批因此 SR 利用率更高；该描述本身正确但刻画的是有丢包时的实际效率，而题目问最大利用率即理想无差错情形，此时不发生重传。同时遗漏题干括号给出的发送窗口与接收窗口相等这一唯一定量入口，也未调用当日已建立的窗口与序号空间通式把三个发送窗口算出来。追问中另暴露三处：把接收窗口理解成总共能收几帧而非能缓存几个失序帧；把发送方能收到多个确认帧归因于接收窗口；认为 GBN 会为连续多帧分别回送独立确认。；先读最大二字确认是理想无差错无重传情形，把发送时延与周期作为公共因子约掉，再用发送窗口加接收窗口不超过序号空间逐协议求发送窗口（停等 1、GBN 2^k − 1、SR 对称时 2…","summary_truncated":true},{"choice_result":null,"chronology_precision":"unknown","conclusion_correct":null,"correction_refs":null,"correction_result":null,"effective_observed_date":null,"effective_outcome":null,"establishes_independent_mastery":false,"event_kind":"observation","event_time":null,"evidence_refs":[{"source_fragment":"lines:136,313,488,568","source_id":"历史错题归档/按错因索引.md","source_kind":"semantic_historical_summary","source_sha256":"5b6744a3ae0becd60137f283d0f4b97a94fb643aea8248195c3607dd0f3ee206"}],"evidence_role":"formal_summary","formal_ids":["CN_UNK_050"],"knowledge_point":"CN03-10","observed_date":"未记录","outcome":null,"point_binding":"explicit_point","prompt_depend